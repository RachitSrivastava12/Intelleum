# ================================
# INTELLEUM V2 — ENVIRONMENT VARS
# Copy to .env and fill in values
# ================================

# Helius RPC (you already have this)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# QuickNode Streams webhook secret

# Render Postgres (copy from Render dashboard)
DATABASE_URL=postgresql://user:password@host:5432/intelleum

# API server
PORT=8081
NODE_ENV=production
CHAIN_INGESTION_ENABLED=true

# Frontend URL (for CORS — your Vercel/Render frontend URL)
FRONTEND_URL=https://intelleum.vercel.app
