{
  "name": "intelleum-backend",
  "version": "2.0.0",
  "description": "Intelleum V2 — MEV Intelligence for Solana",
  "main": "dist/server.js",
  "scripts": {
    "dev":    "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "worker": "ts-node src/worker.ts",
    "build":  "tsc",
    "start":  "node dist/server.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "@types/node":     "^20.0.0",
    "cors":            "^2.8.5",
    "dotenv":          "^16.0.0",
    "express":         "^4.18.2",
    "pg":              "^8.11.0",
    "typescript":      "^5.3.0"
  },
  "devDependencies": {
    "@types/cors":    "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/pg":      "^8.10.9",
    "nodemon":        "^3.1.10",
    "ts-node":        "^10.9.2"
  }
}
